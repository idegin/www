# ─── Contact form email delivery (ZeptoMail / Zoho) ───────────────────────────
# Send Mail token from ZeptoMail (Mail Agents → SMTP/API). Used as the
# "Authorization: Zoho-enczapikey <token>" header. Paste the token only.
ZEPTOMAIL_TOKEN=your-zeptomail-send-mail-token

# Verified sender address on your ZeptoMail domain.
ZEPTOMAIL_FROM=noreply@idegin.com

# Where audit requests are delivered.
CONTACT_TO=hello@idegin.com

# ZeptoMail API endpoint. Use the region that matches your account:
#   Global/US: https://api.zeptomail.com/v1.1/email
#   EU:        https://api.zeptomail.eu/v1.1/email
#   India:     https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
