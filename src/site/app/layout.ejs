<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    <%= locals.metadata?.title || 'The Plug Afrique' %>
  </title>
  <% if (locals.metadata?.description) { %>
    <meta name="description" content="<%= locals.metadata.description %>">
  <% } %>
  <% if (locals.metadata?.keywords) { %>
    <meta name="keywords" content="<%= locals.metadata.keywords.join(', ') %>">
  <% } %>

  <!-- Open Graph / Social Media Meta Tags -->
  <% if (locals.metadata?.og) { %>
    <meta property="og:type" content="<%= locals.metadata.og.type || 'website' %>">
    <% if (locals.metadata.og.url) { %>
      <meta property="og:url" content="<%= locals.metadata.og.url %>">
    <% } %>
    <meta property="og:title" content="<%= locals.metadata.og.title || locals.metadata.title %>">
    <meta property="og:description" content="<%= locals.metadata.og.description || locals.metadata.description %>">
    <% if (locals.metadata.og.image) { %>
      <meta property="og:image" content="<%= locals.metadata.og.image %>">
    <% } %>
  <% } %>

  <!-- Twitter Meta Tags -->
  <% if (locals.metadata?.twitter) { %>
    <meta property="twitter:card" content="<%= locals.metadata.twitter.card || 'summary' %>">
    <% if (locals.metadata.twitter.url) { %>
      <meta property="twitter:url" content="<%= locals.metadata.twitter.url %>">
    <% } %>
    <meta property="twitter:title" content="<%= locals.metadata.twitter.title || locals.metadata.title %>">
    <meta property="twitter:description" content="<%= locals.metadata.twitter.description || locals.metadata.description %>">
    <% if (locals.metadata.twitter.image) { %>
      <meta property="twitter:image" content="<%= locals.metadata.twitter.image %>">
    <% } %>
  <% } %>


   <!-- favicon icon -->
    <link rel="shortcut icon" href="./assets/imgs/favicon.ico">
    <link rel="apple-touch-icon" href="./assets/imgs/apple-touch-icon.png">
    <link rel="android-chrome" sizes="192x192" href="./assets/imgs/android-chrome-192x192.png">
    <link rel="favicon" sizes="32x32" href="./assets/imgs/favicon-32x32.png">

    <!-- Google Fonts -->
    <link href="./fonts.googleapis.com/css27a2a.css?family=Funnel+Display:wght@300..800&amp;display=swap" rel="stylesheet">
    <link href="./fonts.googleapis.com/css22f35.css?family=Mona+Sans:ital,wght@0,200..900;1,200..900&amp;display=swap"
        rel="stylesheet">

    <!-- Plugins -->
    <link rel="stylesheet" href="./assets/css/plugins.css">

    <!-- Core Style Css -->
    <link rel="stylesheet" href="./assets/css/style.css">

 

</head>
<body>

   <!-- ==================== Start Loading ==================== -->

    <div class="loader-wrap">
        <svg viewBox="0 0 1000 1000" preserveAspectRatio="none">
            <path id="svg" d="M0,1005S175,995,500,995s500,5,500,5V0H0Z"></path>
        </svg>

        <div class="loader-wrap-heading">
            <div class="load-text">
                <span>L</span>
                <span>o</span>
                <span>a</span>
                <span>d</span>
                <span>i</span>
                <span>n</span>
                <span>g</span>
            </div>
        </div>
    </div>

    <!-- ==================== End Loading ==================== -->

     <div class="cursor"></div>
    <div class="blur-div"></div>


    <!-- ==================== Start progress-scroll-button ==================== -->

    <div class="progress-wrap cursor-pointer">
        <svg class="progress-circle svg-content" width="100%" height="100%" viewBox="-1 -1 102 102">
            <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98" />
        </svg>
    </div>

    <!-- ==================== End progress-scroll-button ==================== -->


    <%- include('../components/header') %>
    <div id="smooth-wrapper">
        <div id="smooth-content">
            <main class="o-hidden">


              <% if (locals.layoutChain && locals.layoutChain.length > 1) { %>
                <%- include('../' + locals.layoutChain[1], { body: body }) %>
              <% } else { %>
                <%- body %>
              <% } %>


              <%- include('../components/footer') %>
            </main>
        </div>
    </div>




    <!-- jQuery -->
    <script src="./assets/js/jquery-3.6.0.min.js"></script>
    <script src="./assets/js/jquery-migrate-3.4.0.min.js"></script>

    <!-- plugins -->
    <script src="./assets/js/plugins.js"></script>
    <script src="./assets/js/imagesloaded.pkgd.min.js"></script>

    <script src="./assets/js/gsap.min.js"></script>
    <script src="./assets/js/ScrollSmoother.min.js"></script>
    <script src="./assets/js/ScrollTrigger.min.js"></script>
    <script src="./assets/js/smoother-script.js"></script>
    <script src="./assets/js/springer.min.js"></script>

    <!-- custom scripts -->
    <script src="./assets/js/scripts.js"></script>
</body>
</html>
